QWidget {
    background-color: #ffffff;
    color: #202020;
}

QTableWidget {
    background-color: #ffffff;
    gridline-color: #dddddd;
    alternate-background-color: #f5f5f5;
}

QPushButton {
    background-color: #f0f0f0;
    border: 1px solid #cccccc;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    color: #202020;
}
